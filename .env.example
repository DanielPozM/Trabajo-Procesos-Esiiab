# Puerto HTTP
PORT=3000

# URL pública de la aplicación (se usa en los enlaces de confirmación y OAuth)
APP_BASE_URL=http://localhost:3000

# Secreto de firma de la cookie de sesión.
# En producción es obligatorio y debe ser un valor largo y aleatorio.
SESSION_SECRET=

# Persistencia: deja DB_TYPE=:memory: para memoria local, usa 'firestore'
# para Firestore, o define DB_FILE para persistir en un archivo JSON.
DB_TYPE=:memory:
DB_FILE=

# Firestore
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
FIRESTORE_DATABASE_ID=
FIRESTORE_COLLECTION=
SESSION_COLLECTION=

# Administrador inicial (se crea/promociona al arrancar si ambos están definidos)
INIT_ADMIN_EMAIL=
INIT_ADMIN_PASSWORD=

# OAuth con Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/oauth/google/callback

# Correo transaccional por SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Duración del enlace de confirmación (minutos)
VERIFICATION_TOKEN_TTL_MINUTES=1440
